  /* 定義可愛風格的色彩變數 */
  :root {
      --primary-color: #ff9aa2;       /* 粉紅色（主色） */
      --secondary-color: #b5ead7;     /* 薄荷綠（次色） */
      --accent-color: #ffb7b2;        /* 淺粉紅（強調色） */
      --text-color: #333;             /* 深灰色（文字） */
      --background-color: #fff9f9;   /* 淺粉白（背景） */
      --font-family: 'Cute Font', cursive; /* 可愛字體 */
  }

  /* 全局樣式：設定字體和背景 */
  body {
      margin: 0;
      padding: 0;
      font-family: var(--font-family);
      background-color: var(--background-color);
      overflow: hidden; /* 防止滾動條出現 */
  }

  /* 遊戲容器：置中並設定高度 */
  .game-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      position: relative;
  }

  /* 玩家名稱輸入框：可愛風格的彈出框 */
  .name-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      background-color: white;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      z-index: 10;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
  }

  /* 標題樣式 */
  .name-container h1 {
      color: var(--primary-color);
      margin-bottom: 20px;
      font-size: 2.5em;
      text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
  }

  /* 玩家名稱輸入框樣式 */
  #player-name {
      padding: 12px;
      font-size: 1.2em;
      border: 3px solid var(--primary-color);
      border-radius: 15px;
      text-align: center;
      margin-bottom: 20px;
      width: 200px;
      outline: none;
      transition: border-color 0.3s;
  }

  #player-name:focus {
      border-color: var(--accent-color);
  }

  /* 開始按鈕樣式 */
  #start-button {
      padding: 12px 30px;
      font-size: 1.2em;
      background-color: var(--primary-color);
      color: white;
      border: none;
      border-radius: 15px;
      cursor: pointer;
      transition: transform 0.2s, background-color 0.2s;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
  }

  #start-button:hover {
      transform: scale(1.05);
      background-color: #ff8a92;
  }

  /* 遊戲畫布樣式 */
  #game-canvas {
      border: 6px solid var(--primary-color);
      border-radius: 15px;
      background-color: var(--secondary-color);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
      display: none; /* 初始隱藏，遊戲開始後顯示 */
  }

  /* 分數顯示樣式（置於畫面中間最上方） */
  #score-display {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 2.5em;
      color: var(--primary-color);
      text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.2);
      z-index: 5;
      animation: score-pulse 0.5s ease-out; /* 分數增加時跳動 */
  }

  /* 分數跳動動畫 */
  @keyframes score-pulse {
      0% { transform: translateX(-50%) scale(1); }
      50% { transform: translateX(-50%) scale(1.2); }
      100% { transform: translateX(-50%) scale(1); }
  }

  /* 排名顯示樣式（置於畫面左上方） */
  #leaderboard {
      position: absolute;
      top: 20px;
      left: 20px;
      background-color: white;
      padding: 15px;
      border-radius: 15px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
      width: 180px;
      text-align: left;
      z-index: 5;
  }

  #leaderboard h3 {
      color: var(--primary-color);
      margin-top: 0;
      font-size: 1.3em;
      text-align: center;
  }

  #leaderboard-list {
      margin: 0;
      padding-left: 20px;
      font-size: 1em;
  }

  /* 恐龍眨眼動畫 */
  @keyframes blink {
      0%, 49%, 100% { opacity: 1; }
      50%, 99% { opacity: 0; }
  }

